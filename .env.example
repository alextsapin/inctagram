# Адрес бэкенда для локальной разработки. Пусто — запросы идут на тот же домен.
NEXT_PUBLIC_API_URL=
# Temporary mocks instead of the real API (for layout work without backend).
# true - getMe returns MOCK_ME from src/entities/session/api/mock.ts.
NEXT_PUBLIC_USE_MOCKS=false
# Ключи reCAPTCHA v2 (site key): с галочкой и невидимый. Пусто — используется публичный тестовый ключ Google.
# Локально оставляем пустыми: настоящие ключи работают только на домене blackdragonmedia.info.
# На деплое прописать эти значения (site key публичные, их можно хранить здесь):
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY_CHECKBOX=6Lc71AQuAAAAANehzC_S9hq6A2Hzn02YZeFtsPzN
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY_INVISIBLE=6LfF0wQuAAAAAPKRG6ec8X-B4m0JOsjngS4o6gyK
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_CHECKBOX=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_INVISIBLE=

# BLD-115: Temporary client IP forwarding
# Disable when the reverse proxy correctly forwards the user's IP.
NEXT_PUBLIC_CLIENT_IP_ENABLED=true

# HTTP header expected by the backend (temporary value).
NEXT_PUBLIC_CLIENT_IP_HEADER=X-Client-IP

# External service returning the user's public IP.
NEXT_PUBLIC_CLIENT_IP_SERVICE_URL=https://api.ipify.org?format=json
