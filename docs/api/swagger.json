    "/api/v1/auth/registration": {
      "post": {
        "operationId": "AuthController_registration",
        "parameters": [
          {
            "name": "X-Recaptcha-Token",
            "in": "header",
            "description": "reCAPTCHA v2 token. Not checked while the server has no reCAPTCHA secrets.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Recaptcha-Type",
            "in": "header",
            "description": "Which widget issued the token",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "invisible",
                "checkbox"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsMessagesDto"
                }
              }
            }
          },
          "403": {
            "description": "reCAPTCHA check failed"
          },
          "409": {
            "description": "Email or username is taken"
          },
          "429": {
            "description": "Too many requests from this IP"
          },
          "503": {
            "description": "Google reCAPTCHA did not respond"
          }
        },
        "summary": "Register and send a confirmation link",
        "tags": [
          "auth"
        ]
      }
    },
