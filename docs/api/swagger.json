    "/api/v1/auth/google": {
      "get": {
        "description": "Open via window.location, not fetch. The result comes back through the callback redirect.",
        "operationId": "OAuthController_google",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirect to Google consent page"
          },
          "429": {
            "description": "Too many requests from this IP"
          }
        },
        "summary": "Start login with Google",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "description": "Called by the provider, not by the frontend. On success sets the refresh cookie; then call POST /api/v1/auth/refresh for the access token. Failure reasons: access_denied, expired, invalid_state, account_conflict, server_error.",
        "operationId": "OAuthController_googleCallback",
        "parameters": [
          {
            "name": "code",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Set when the user denied access",
            "schema": {}
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to FRONTEND_URL/auth/oauth/success or FRONTEND_URL/auth/oauth/failure?error=<reason>"
          }
        },
        "summary": "Google OAuth callback",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/v1/auth/github": {
      "get": {
        "description": "Open via window.location, not fetch. The result comes back through the callback redirect.",
