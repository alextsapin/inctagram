                  "$ref": "#/components/schemas/ErrorsMessagesDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          },
          "413": {
            "description": "Image exceeds the size limit or cannot be compressed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create post",
        "tags": [
          "post"
        ]
      }
    },
    "/api/v1/{username}/profile": {
      "get": {
        "description": "Public. Stub: subscriptions contain only the user themselves, followers is always 1.",
        "operationId": "ProfileController_findOne",
        "parameters": [
          {
            "name": "username",
            "required": true,
            "in": "path",
            "description": "Username, case-insensitive",
            "schema": {
              "example": "ivan_petrov",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid username",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsMessagesDto"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "User profile",
        "tags": [
          "profile"
        ]
      }
    },
    "/api/v1/profile": {
      "put": {
        "description": "All fields are optional: absent ones are not changed. null clears avatar and description; null username is ignored.",
        "operationId": "ProfileController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Profile updated"
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsMessagesDto"
                }
              }
            }
          },
          "401": {
            "description": "Access token is missing, invalid or expired"
          },
          "403": {
            "description": "Email is not confirmed. After confirming, call POST /api/v1/auth/refresh to get a new access token"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Username is already taken"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update own profile",
        "tags": [
          "profile"
        ]
      }
    }
  },
  "info": {
    "title": "Inctagram API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refreshToken": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "schemas": {
      "PingResponseDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Name of the responding module",
            "example": "auth"
          },
          "timestamp": {
            "type": "string",
            "description": "Server time, ISO 8601",
            "format": "date-time"
          }
        },
        "required": [
          "service",
          "timestamp"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "example": "ivan_petrov"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "example": "ivan@example.com",
            "description": "null after GitHub login without an email — ask for one"
          }
        },
        "required": [
          "userId",
          "username",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Trimmed and lowercased before validation",
            "example": "ivan@example.com"
          },
          "password": {
            "type": "string",
            "example": "Qwerty1!",
            "minLength": 6,
            "maxLength": 20
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token; default expiry is 15 minutes"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Minimum number of characters 6"
          },
          "field": {
            "type": "string",
            "description": "Request field",
            "example": "password"
          }
        },
        "required": [
          "message",
          "field"
        ]
      },
      "ErrorsMessagesDto": {
        "type": "object",
        "properties": {
          "errorsMessages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "errorsMessages"
        ]
      },
      "RegistrationDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 6,
            "maxLength": 30,
            "pattern": "^[0-9A-Za-z_-]+$",
            "description": "Unique case-insensitively; stored as typed",
            "example": "ivan_petrov"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "Trimmed and lowercased before validation",
            "example": "ivan@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20,
            "description": "Password must contain 0-9, a-z, A-Z, ! \" # $ % & ' ( ) * + , - . / : ; < = > ? @ [ \\ ] ^ _ { } ~",
            "example": "Qwerty1!"
          },
          "passwordConfirmation": {
            "type": "string",
            "description": "Must be equal to password",
            "example": "Qwerty1!"
          },
          "termsAccepted": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Must be true"
          }
        },
        "required": [
          "username",
          "email",
          "password",
          "passwordConfirmation",
          "termsAccepted"
        ]
      },
      "RegistrationResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Address the confirmation link was sent to",
            "example": "ivan@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "AddEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "Trimmed and lowercased before validation",
            "example": "ivan@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConfirmEmailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code query parameter from the email link",
            "example": "q3Jx0l8m3VZ6bJ9a0nYp1cK7wR2tE5uH4iO6pA8sD0f"
          }
        },
        "required": [
          "code"
        ]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Trimmed and lowercased before validation",
            "example": "ivan@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordRecoveryDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Trimmed and lowercased before validation",
            "example": "ivan@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "NewPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20,
            "description": "Password must contain 0-9, a-z, A-Z, ! \" # $ % & ' ( ) * + , - . / : ; < = > ? @ [ \\ ] ^ _ { } ~",
            "example": "Qwerty1!"
          },
          "passwordConfirmation": {
            "type": "string",
            "description": "Must be equal to newPassword",
            "example": "Qwerty1!"
          },
          "code": {
            "type": "string",
            "description": "The code query parameter from the email link",
            "example": "q3Jx0l8m3VZ6bJ9a0nYp1cK7wR2tE5uH4iO6pA8sD0f"
          }
        },
        "required": [
          "newPassword",
          "passwordConfirmation",
          "code"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Session (device) id"
          },
          "ipAddress": {
            "type": "string",
            "nullable": true,
            "example": "203.0.113.7"
          },
          "userAgent": {
            "type": "string",
            "nullable": true,
            "description": "Raw User-Agent of the device",
            "example": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/141.0"
          },
          "lastActiveAt": {
            "format": "date-time",
            "type": "string",
            "description": "Last token refresh"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Login time on this device"
          },
          "current": {
            "type": "boolean",
            "description": "The session of this request"
          }
        },
        "required": [
          "deviceId",
          "ipAddress",
          "userAgent",
          "lastActiveAt",
          "createdAt",
          "current"
        ]
      },
      "PostPhotoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "minimum": 0,
            "example": 0,
            "description": "Photo index in this post, starting at 0"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "url"
        ]
      },
      "PostAuthorResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username",
          "avatarUrl"
        ]
      },
      "PostWithAuthorResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "photos": {
            "description": "Public URLs of original photos; files are uploaded in background",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPhotoResponseDto"
            }
          },
          "previewUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "likesCount": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "commentsCount": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "$ref": "#/components/schemas/PostAuthorResponseDto"
          }
        },
        "required": [
          "id",
          "authorId",
          "description",
          "photos",
          "previewUrl",
          "likesCount",
          "commentsCount",
          "createdAt",
          "updatedAt",
          "author"
        ]
      },
      "PostsResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostWithAuthorResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Unix milliseconds_UUID; pass as cursor for the next page; null means the end",
            "pattern": "^\\d{1,13}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "example": "1794484800000_123e4567-e89b-42d3-a456-426614174000"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "MainFeedResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostWithAuthorResponseDto"
            }
          },
          "registeredUsersCount": {
            "type": "number",
            "example": 1250,
            "description": "Approximate number of registered users"
          }
        },
        "required": [
          "items",
          "registeredUsersCount"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "description"
        ]
      },
      "PostResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "photos": {
            "description": "Public URLs of original photos; files are uploaded in background",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPhotoResponseDto"
            }
          },
          "previewUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "likesCount": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "commentsCount": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "authorId",
          "description",
          "photos",
          "previewUrl",
          "likesCount",
          "commentsCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "example": "ivan_petrov"
          },
          "avatar": {
            "type": "string",
            "nullable": true,
            "description": "Avatar URL"
          },
          "subscriptions": {
            "description": "Ids of followed users. Stub: only the user themselves",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "followers": {
            "type": "number",
            "description": "Stub: always 1 (the user themselves)"
          },
          "publications": {
            "type": "integer",
            "minimum": 0,
            "example": 0,
            "description": "Number of created posts"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "About me"
          }
        },
        "required": [
          "uid",
          "username",
          "avatar",
          "subscriptions",
          "followers",
          "publications",
          "description"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true,
            "minLength": 6,
            "maxLength": 30,
            "pattern": "^[0-9A-Za-z_-]+$",
            "description": "Unique case-insensitively. null or absent — not changed",
            "example": "ivan_petrov"
          },
          "avatar": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "maxLength": 2048,
            "description": "Avatar URL. null — remove, absent — not changed"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "description": "About me. null — clear, absent — not changed"
          }
        }
      }
    }
  }
}
