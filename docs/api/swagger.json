        "summary": "Start login with GitHub",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/v1/auth/github/callback": {
      "get": {
        "description": "Called by the provider, not by the frontend. On success sets the refresh cookie; then call POST /api/v1/auth/refresh for the access token. Failure reasons: access_denied, expired, invalid_state, account_conflict, server_error. Without a verified GitHub email the user gets email null and must call POST /api/v1/auth/add-email.",
        "operationId": "OAuthController_githubCallback",
        "parameters": [
          {
            "name": "code",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Set when the user denied access",
            "schema": {}
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to FRONTEND_URL/auth/oauth/success or FRONTEND_URL/auth/oauth/failure?error=<reason>"
          }
        },
        "summary": "GitHub OAuth callback",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/v1/{userId}/posts": {
      "get": {
        "description": "Public. Up to 8 posts, newest first. Use nextCursor for the next page.",
        "operationId": "PostController_findAll",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "description": "Post author ID",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Unix milliseconds_UUID from nextCursor; omit for the first page",
            "schema": {
              "pattern": "^\\d{1,13}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "example": "1794484800000_123e4567-e89b-42d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user UUID or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsMessagesDto"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "User posts",
        "tags": [
          "post"
        ]
      }
    },
